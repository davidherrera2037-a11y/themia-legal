# Proyecto Supabase de Themia Legal.
#
# La clave "anon" es de cliente: viaja al navegador y por sí sola no da
# acceso a nada. Quien decide qué fila puede leer o escribir cada persona
# son las políticas RLS de supabase/migrations. Este proyecto NO usa la
# clave de servicio (service_role) en ninguna parte.
#
# Dónde encontrarlas: Supabase → tu proyecto → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-CLAVE-ANON

# Dirección pública del sitio ya publicado, sin barra final.
# Se usa para las etiquetas de redes sociales, el sitemap y robots.txt.
NEXT_PUBLIC_SITE_URL=https://themialegal.com
